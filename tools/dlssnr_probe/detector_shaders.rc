IDF_PS_11_DLSS_COMPOSE_1        FILE    "ps_dlss_compose_joint.cso"
IDF_PS_11_DLSS_COMPOSE_2        FILE    "ps_dlss_compose_sums.cso"
IDF_PS_11_DLSS_COMPOSE_3        FILE    "ps_dlss_compose_ab.cso"
IDF_PS_11_DLSS_COMPOSE_4        FILE    "ps_dlss_compose_abx.cso"
