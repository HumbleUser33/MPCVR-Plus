// The stabilizer's shaders, embedded the way the filter embeds them
// (Source\res\MpcVideoRenderer.rc2), so the harness runs CDlssStabilizer and
// CDlssCompose unchanged.
// build.cmd compiles the .cso files next to this script first.

#include "..\\..\\Source\\resource.h"

IDF_PS_11_DLSS_STAB_FLOWFRAME   FILE    "ps_dlss_stab_flowframe.cso"
